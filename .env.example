# Portas do host (escolhidas para não colidir com os outros projetos do WSL)
API_PORT=8100
WEB_PORT=3100
DB_PORT=5433
REDIS_PORT=6380
MAILPIT_PORT=8125

# Login com o Google. Ligue depois de preencher as credenciais em
# apps/api/.env — ver docs/DEPLOY.md.
GOOGLE_LOGIN_ENABLED=false

DB_DATABASE=orbital
DB_USERNAME=orbital
DB_PASSWORD=secret

# UID/GID do usuário do WSL, para os arquivos gerados não virem como root
UID=1000
GID=1000
