# ==========================================================================
# Produção — copie para .env.production na VPS e preencha.
#
# Este arquivo NUNCA entra no Git. O .gitignore já bloqueia .env.production.
# Gere as senhas com: openssl rand -base64 32
# Gere a APP_KEY com:  docker compose -f docker-compose.prod.yml run --rm api php artisan key:generate --show
# ==========================================================================

# --- Borda ---------------------------------------------------------------
SITE_DOMAIN=orbital.exemplo.com.br
ACME_EMAIL=voce@exemplo.com.br

# --- Aplicação -----------------------------------------------------------
APP_NAME=Orbital
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://orbital.exemplo.com.br
FRONTEND_URL=https://orbital.exemplo.com.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# `stderr` porque o Docker já coleta a saída dos containers; gravar em arquivo
# dentro do container só criaria log que ninguém encontra.
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- Banco ---------------------------------------------------------------
# `postgres` é o nome do serviço no Compose; a porta não é publicada no host.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=orbital
DB_USERNAME=orbital
DB_PASSWORD=

# --- Cache, fila e sessão ------------------------------------------------
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Autenticação --------------------------------------------------------
# Sete dias, em minutos. O cookie do BFF no Next usa o mesmo horizonte.
SANCTUM_TOKEN_EXPIRATION=10080

# --- E-mail --------------------------------------------------------------
# Resend. Trocar para `log` desativa o envio sem tirar o código do ar --
# útil para subir a aplicação antes de o DNS do domínio estar propagado.
#
# Antes de virar para `resend`, os três registros DNS precisam existir na
# zona do domínio (SPF, DKIM e DMARC): sem eles a mensagem sai, mas cai em
# spam -- e e-mail de recuperação em spam é o mesmo que e-mail não enviado.
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS=nao-responda@orbital.exemplo.com.br
MAIL_FROM_NAME="${APP_NAME}"
