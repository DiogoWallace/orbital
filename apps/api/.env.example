APP_NAME=Orbital
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8100

# Origem do frontend. Usada em links de e-mail; NÃO é usada para CORS —
# o browser nunca chama esta API diretamente (ADR 0004).
FRONTEND_URL=http://localhost:3100

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Hostnames são nomes de serviço do Compose; de fora do Docker use
# localhost:5433 (postgres) e localhost:6380 (redis).
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=orbital
DB_USERNAME=orbital
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit: nada sai da máquina. Interface em http://localhost:8125
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS="nao-responda@orbital.local"
MAIL_FROM_NAME="${APP_NAME}"

# Expiração do token Sanctum, em minutos (7 dias). O cookie do BFF no Next
# usa o mesmo horizonte, para que os dois não desalinhem.
SANCTUM_TOKEN_EXPIRATION=10080

# --- Google Identity ------------------------------------------------------
# Credenciais do OAuth 2.0 em console.cloud.google.com. A URI de redirecionamento
# autorizada precisa ser exatamente o valor de GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8100/api/v1/auth/google/callback
