{
	# Let's Encrypt precisa de um endereço para avisos de expiração.
	email {$ACME_EMAIL}

	# Descomente para testar sem gastar a cota de emissão do Let's Encrypt
	# (o certificado será inválido no navegador, mas o fluxo é idêntico):
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

{$SITE_DOMAIN} {
	encode zstd gzip

	header {
		# Um ano, subdomínios inclusos. Só ative `preload` na lista da HSTS
		# quando tiver certeza — sair de lá leva meses.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# A API é pública por decisão de arquitetura (ADR 0002): ela serve o BFF
	# hoje e qualquer outro cliente amanhã. O navegador da aplicação não passa
	# por aqui — ele fala com os route handlers do Next.
	handle /api/* {
		reverse_proxy nginx:80
	}

	# Healthcheck do Laravel, útil para monitoramento externo.
	handle /up {
		reverse_proxy nginx:80
	}

	handle {
		reverse_proxy web:3000
	}

	# Rede de segurança da borda: o upstream não respondeu.
	#
	# Isto cobre a janela em que o Next está fora — a troca de containers de
	# todo deploy, um processo que morreu, um build que ainda não subiu. As
	# telas de erro da aplicação não servem aqui, porque quem as renderiza é
	# justamente o que caiu; esta página é HTML estático, sem dependência
	# nenhuma, servida pelo próprio Caddy.
	#
	# `status {err.status_code}` preserva o código original (502, 503, 504) em
	# vez de responder 200 com cara de erro. A diferença importa para o
	# monitoramento e para o buscador: uma indisponibilidade que se anuncia
	# como sucesso é pior que a indisponibilidade.
	handle_errors {
		root * /srv/erros
		rewrite * /indisponivel.html
		# O `templates` existe por um motivo só: escrever o código real na
		# página. Uma tela fixa dizendo 503 enquanto a resposta é 502 seria uma
		# mentira pequena, mas é justamente aqui que a interface não pode
		# mentir. Fora esse número, a página continua estática.
		templates
		file_server {
			status {err.status_code}
		}
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 20mb
			roll_keep 5
		}
		format json
	}
}
